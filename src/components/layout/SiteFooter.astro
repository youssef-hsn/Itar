---
const year = new Date().getFullYear();
---

<footer class="border-border border-t">
  <div
    class="mx-auto flex w-full max-w-[var(--container-max)] flex-col gap-2 px-4 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="type-label text-muted-foreground">
      Itar &middot; {year} &middot; Runs entirely in your browser.
    </p>
    <a
      href="https://github.com/youssef-hsn/Itar"
      class="type-label min-h-11 content-center text-muted-foreground hover:text-foreground"
    >
      Source
    </a>
  </div>
</footer>
