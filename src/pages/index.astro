---
import BaseLayout from '#/components/layout/BaseLayout.astro';
import { FrameEditor } from '#/features/frame/components/FrameEditor.tsx';
import { HeroSpecimen } from '#/features/frame/components/HeroSpecimen.tsx';
---

<BaseLayout
  title="Itar — Arabic image borders"
  description="Drop a photo, tweak a few frame parameters, and download a bordered PNG — entirely in your browser."
>
  <main>
    <section
      class="mx-auto w-full max-w-[var(--container-max)] px-4 py-12 lg:py-16"
      aria-labelledby="hero-heading"
    >
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <div class="flex flex-col gap-6">
          <p class="type-display text-teal-700">Itar</p>
          <h1 id="hero-heading" class="type-headline text-ink-900">
            Arabic borders for any image, in about a minute.
          </h1>
          <p class="type-body max-w-[42ch] text-ink-800">
            Drop a photo anywhere on this page. Itar builds the frame from stacked strokes — the
            double rule, the gold hairline, the wide mat — and hands you a PNG. Nothing uploads; it
            all happens on your device.
          </p>
          <p class="type-body max-w-[42ch] text-ink-700">
            <strong class="font-semibold text-ink-800">Why this exists.</strong> The frames that make
            Arabic and Islamic art feel finished are just a few concentric lines in the right
            proportions. Getting them right otherwise means opening a design tool, starting a new
            file, and nudging rectangles for twenty minutes. Here it's four numbers and a colour —
            plus a link you can send someone so they can put the same frame on their own image.
          </p>
        </div>
        <HeroSpecimen client:load />
      </div>
    </section>

    <FrameEditor client:load />
  </main>
</BaseLayout>
