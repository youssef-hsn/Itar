---
import BaseLayout from '#/components/layout/BaseLayout.astro';
import Faq from '#/features/landing/components/Faq.astro';
import HowItWorks from '#/features/landing/components/HowItWorks.astro';
import Privacy from '#/features/landing/components/Privacy.astro';
import ShareAFrame from '#/features/landing/components/ShareAFrame.astro';
import WhyItExists from '#/features/landing/components/WhyItExists.astro';
import { PresetGallery } from '#/features/landing/components/PresetGallery.tsx';
---

<BaseLayout
  title="Itar — Arabic image borders"
  description="Drop a photo, adjust four numbers, download the PNG. Nothing uploads — it all runs on your device."
>
  <script is:inline>
    (() => {
      const encoded = new URLSearchParams(window.location.search).get('f');
      if (encoded) {
        window.location.replace(`/editor?f=${encodeURIComponent(encoded)}`);
      }
    })();
  </script>

  <main>
    <section
      class="mx-auto w-full max-w-[var(--container-max)] px-4 py-12 lg:py-20"
      aria-labelledby="hero-heading"
    >
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col items-start gap-6">
          <h1 id="hero-heading" class="type-display text-foreground-strong">
            Put an Arabic border on any image.
          </h1>
          <p class="type-body max-w-[46ch] text-foreground">
            Drop a photo, adjust four numbers, download the PNG. Nothing uploads &mdash;
            it all runs on your device.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/editor"
              class="type-label inline-flex min-h-11 items-center justify-center rounded-sm border border-transparent bg-primary px-5 text-primary-foreground transition-colors duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:bg-primary-hover"
            >
              Open the editor
            </a>
            <span class="type-label text-muted-foreground">
              &hellip;or drop a photo anywhere on this page
            </span>
          </div>
        </div>

        <div id="frames" class="scroll-mt-20">
          <PresetGallery client:load />
        </div>
      </div>
    </section>

    <HowItWorks />
    <WhyItExists />
    <Privacy />
    <ShareAFrame />
    <Faq />
  </main>
</BaseLayout>
